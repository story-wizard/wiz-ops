{
  "clip_effects.add_keyframe_at_time": {
    "additionalProperties": true,
    "properties": {
      "bundle": {
        "description": "Path to the .wiz bundle",
        "type": "string"
      },
      "clip_id": {
        "description": "Clip id (UUID-v7 token)",
        "type": "string"
      },
      "expect_revision": {
        "description": "Optional autosave bundle_version expected by the caller; enforced by dispatch (Tier-1): a stale expectation on a targeted clip is rejected with stale_revision and the current revision to retry with. Ops that target no clip (timeline/track/settings/asset mutations) only require the revision to be a known bundle_version — best-effort under concurrency, per-clip collisions are the Tier-1 scope",
        "type": "string"
      },
      "node_id": {
        "description": "Render-graph node id (graph targets only; default 0)",
        "type": "integer"
      },
      "target_kind": {
        "description": "Target kind: 'native' (default) or 'graph'",
        "enum": [
          "native",
          "graph"
        ],
        "type": "string"
      },
      "target_path": {
        "description": "Automation target: native property id (e.g. gain_db) or graph pass param key",
        "type": "string"
      },
      "time": {
        "additionalProperties": false,
        "description": "Exact key time, seconds from the clip's left edge, as get_automation returns it",
        "properties": {
          "frame": {
            "description": "Nearest whole frame",
            "type": "integer"
          },
          "rate": {
            "additionalProperties": false,
            "description": "Channel rate as num/den frames per second",
            "properties": {
              "den": {
                "description": "Positive rate fraction term",
                "minimum": 1,
                "type": "integer"
              },
              "num": {
                "description": "Positive rate fraction term",
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "num",
              "den"
            ],
            "type": "object"
          },
          "sub": {
            "description": "Exact remainder past the whole frame",
            "maximum": 0.5,
            "minimum": -0.5,
            "type": "number"
          }
        },
        "required": [
          "frame",
          "sub",
          "rate"
        ],
        "type": "object"
      },
      "time_sec": {
        "description": "Seconds from the clip's left edge, kept exactly; with time, it must name the same instant",
        "type": "number"
      },
      "timeline_id": {
        "description": "Timeline id",
        "type": "string"
      }
    },
    "required": [
      "bundle",
      "timeline_id",
      "clip_id",
      "target_path"
    ],
    "type": "object"
  },
