  "graph.analyze_node": {
    "additionalProperties": true,
    "properties": {
      "bundle": {
        "description": "Path to the .wiz bundle",
        "type": "string"
      },
      "clip_id": {
        "description": "Clip id",
        "type": "string"
      },
      "node_id": {
        "description": "Durable graph node id as canonical signed int32 decimal string",
        "type": "string"
      },
      "rerun": {
        "description": "Start Analyze again even though a job for the node's current key has already finished; without it a call reports that job's state",
        "type": "boolean"
      },
      "timeline_id": {
        "description": "Timeline id",
        "type": "string"
      }
    },
    "required": [
      "bundle",
      "timeline_id",
      "clip_id",
      "node_id"
    ],
    "type": "object"
  },
  "media.detect_color": {
    "additionalProperties": true,
    "properties": {
      "bundle": {
        "description": "Optional .wiz bundle path scoping this op's path confinement to that bundle's registered media roots (#839); the op stays project-less and never opens the bundle",
        "type": "string"
      },
      "category": {
        "description": "Media category override: exr_image, camera_raw_video, raw_still, video, still, or unknown; omitted/empty defaults to video (camera_raw_video for a camera RAW video path)",
        "enum": [
          "",
          "exr_image",
          "camera_raw_video",
          "raw_still",
          "video",
          "still",
          "unknown"
        ],
        "type": "string"
      },
      "config_path": {
        "description": "Absolute OCIO config path for config_source ui/env; omitted for builtin",
        "type": "string"
      },
      "config_source": {
        "description": "Color config source: builtin, ui, or env (default builtin)",
        "enum": [
          "builtin",
          "ui",
          "env"
        ],
        "type": "string"
      },
      "declared_interop_id": {
        "description": "Optional Color Interop Forum id of the declared space, e.g. 'srgb_rec709_display'; lets a config that spells the space differently still validate the declaration",
        "type": "string"
      },
      "declared_name": {
        "description": "Optional producer declaration of the encoding (OCIO name, e.g. 'sRGB - Display'); validated against the config, never trusted verbatim — an unvalidated declaration falls through to detection",
        "type": "string"
      },
      "declared_producer": {
        "description": "Optional token naming who declared it (diagnostic; becomes match_source 'declared:<producer>')",
        "type": "string"
      },
      "default_policy": {
        "description": "'none' (default) or 'per_category': when nothing resolves, apply Wizard's per-category default (video -> Rec.1886/Rec.709 display, still -> sRGB display), returned with provenance 'defaulted'",
        "type": "string"
      },
      "path": {
        "description": "Absolute path to the media file to inspect (not a .wiz bundle)",
        "type": "string"
      }
    },
    "required": [
      "path"
    ],
    "type": "object"
  },
  "render.set_render_mode": {
    "additionalProperties": true,
    "properties": {
      "bundle": {
        "description": "Path to the .wiz bundle",
        "type": "string"
      },
      "mode": {
        "description": "Timeline preview resolution while playing or scrubbing, the same setting as the viewer's selector: 'full' (no reduction), 'auto', 'half', 'quarter', or 'eighth'",
        "enum": [
          "full",
          "auto",
          "half",
          "quarter",
          "eighth"
        ],
        "type": "string"
      }
    },
    "required": [
      "bundle",
      "mode"
    ],
    "type": "object"
  },
  "search.query": {
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "scope": {
              "properties": {
                "kind": {
                  "const": "timelines"
                }
              }
            }
          },
          "required": [
            "scope"
          ]
        },
        "then": {
          "not": {
            "anyOf": [
              {
                "required": [
                  "predicate"
                ]
              },
              {
                "required": [
                  "limit"
                ]
              }
            ]
          }
        }
      }
    ],
    "properties": {
      "bundle": {
        "description": "Path to the .wiz bundle",
        "type": "string"
      },
      "include": {
        "default": [],
        "items": {
          "const": "excerpt",
          "description": "Optional evidence expansion",
          "type": "string"
        },
        "maxItems": 1,
        "type": "array",
        "uniqueItems": true
      },
      "limit": {
        "default": 50,
        "description": "Maximum matches for inventory scope; not accepted for timelines",
        "maximum": 50,
        "minimum": 1,
        "type": "integer"
      },
      "predicate": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "description": "Stable Media Bin Smart Bin identity",
            "enum": [
              "video",
              "audio",
              "stills",
              "timelines",
              "documents",
              "offline",
              "unused"
            ],
            "type": "string"
          },
          "kind": {
            "const": "smart_bin",
            "description": "Search predicate kind",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "id"
        ],
        "type": "object"
      },
      "query": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "text",
            "description": "Search query modality",
            "type": "string"
          },
          "text": {
            "description": "Nonblank project-media search query",
            "maxLength": 4096,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "text"
        ],
        "type": "object"
      },
      "scope": {
        "default": {
          "kind": "project"
        },
        "description": "Inventory or placed timeline content to search",
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "project",
                "description": "Project-media search scope kind",
                "type": "string"
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "bin_id": {
                "description": "Concrete current-bin identity; 'root' addresses the implicit root",
                "maxLength": 4096,
                "minLength": 1,
                "pattern": "\\S",
                "type": "string"
              },
              "kind": {
                "const": "bin",
                "description": "Project-media search scope kind",
                "type": "string"
              },
              "recursive": {
                "const": false,
                "default": false,
                "description": "V1 searches direct bin membership only",
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "bin_id"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "asset_ids": {
                "items": {
                  "description": "Registered project asset included in an explicit scope",
                  "maxLength": 256,
                  "minLength": 1,
                  "pattern": "\\S",
                  "type": "string"
                },
                "maxItems": 4096,
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "kind": {
                "const": "assets",
                "description": "Project-media search scope kind",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "asset_ids"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "timelines",
                "description": "Project-media search scope kind",
                "type": "string"
              },
              "timeline_ids": {
                "description": "Omitted selects all timelines; empty selects none",
                "items": {
                  "description": "Registered timeline identity",
                  "maxLength": 256,
                  "minLength": 1,
                  "pattern": "\\S",
                  "type": "string"
                },
                "maxItems": 4096,
                "minItems": 0,
                "type": "array",
                "uniqueItems": true
              }
            },
            "required": [
              "kind"
            ],
            "type": "object"
          }
        ]
      },
      "sources": {
        "default": [
          "name",
          "visual",
          "transcript"
        ],
        "items": {
          "description": "Enabled retrieval source",
          "enum": [
            "name",
            "visual",
            "transcript"
          ],
          "type": "string"
        },
        "maxItems": 3,
        "minItems": 1,
        "type": "array",
        "uniqueItems": true
      }
    },
    "required": [
      "bundle",
      "query"
    ],
    "type": "object"
  },
