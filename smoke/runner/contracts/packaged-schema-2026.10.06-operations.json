  "track_effects.add_keyframe_at_time": {
    "additionalProperties": true,
    "properties": {
      "bundle": {
        "description": "Path to the .wiz bundle",
        "type": "string"
      },
      "expect_revision": {
        "description": "Optional autosave bundle_version expected by the caller; enforced by dispatch (Tier-1): a stale expectation on a targeted clip is rejected with stale_revision and the current revision to retry with. Ops that target no clip (timeline/track/settings/asset mutations) only require the revision to be a known bundle_version — best-effort under concurrency, per-clip collisions are the Tier-1 scope",
        "type": "string"
      },
      "target_kind": {
        "description": "Target kind: 'native_param' (default) or 'insert_param' (built-in EQ/compressor parameter, values in native units — Hz, dB, ms)",
        "enum": [
          "native_param",
          "insert_param"
        ],
        "type": "string"
      },
      "target_path": {
        "description": "Registered track property id from the track binding table (e.g. 'gain_db'), or with target_kind='insert_param' a built-in insert path: eq.band.<0-5>.{freq_hz,q,gain_db} or comp.{threshold_db,ratio,attack_ms,release_ms,makeup_db}",
        "type": "string"
      },
      "time": {
        "additionalProperties": false,
        "description": "Exact timeline time, kept as given; wins over time_sec",
        "properties": {
          "frame": {
            "description": "Nearest whole frame",
            "type": "integer"
          },
          "rate": {
            "additionalProperties": false,
            "description": "Channel rate as num/den frames per second",
            "properties": {
              "den": {
                "description": "Positive rate fraction term",
                "minimum": 1,
                "type": "integer"
              },
              "num": {
                "description": "Positive rate fraction term",
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "num",
              "den"
            ],
            "type": "object"
          },
          "sub": {
            "description": "Exact remainder past the whole frame",
            "maximum": 0.5,
            "minimum": -0.5,
            "type": "number"
          }
        },
        "required": [
          "frame",
          "sub",
          "rate"
        ],
        "type": "object"
      },
      "time_sec": {
        "description": "Timeline time in seconds (frame-snapped at the timeline rate)",
        "type": "number"
      },
      "timeline_id": {
        "description": "Timeline id",
        "type": "string"
      },
      "track_id": {
        "description": "Track id (track_<uuid>) of the automated track",
        "type": "string"
      }
    },
    "required": [
      "bundle",
      "timeline_id",
      "track_id",
      "target_path"
    ],
    "type": "object"
  }
}
