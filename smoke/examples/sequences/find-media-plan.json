{
  "format": "athanor-agent-plan/v1",
  "start": "inspect-query",
  "maxDurationMs": 30000,
  "phases": [
    {
      "id": "inspect-query",
      "steps": [{"operation":"observe","params":{"selector":{"id":"OBSERVED_SEARCH_FIELD_ID"}},"expect":{"path":["matchCount"],"equals":1}}],
      "next": {"step":0,"path":["matches",0,"text"],"cases":[{"equals":"","phase":"enter-query"},{"equals":"YOUR_SEARCH_TERM","phase":"results"}]}
    },
    {
      "id": "enter-query",
      "steps": [
        {"operation":"physical","params":{"command":"click","target":{"id":"OBSERVED_SEARCH_FIELD_ID"},"title":"Focus the media search"}},
        {"operation":"physical","params":{"command":"key","target":{"id":"OBSERVED_SEARCH_FIELD_ID","focused":true},"key":"cmd+a"}},
        {"operation":"physical","params":{"command":"type","target":{"id":"OBSERVED_SEARCH_FIELD_ID","focused":true},"text":"YOUR_SEARCH_TERM"}},
        {"operation":"physical","params":{"command":"key","target":{"id":"OBSERVED_SEARCH_FIELD_ID","focused":true},"key":"return"}}
      ],
      "next": "results"
    },
    {
      "id": "results",
      "steps": [
        {"operation":"wait","params":{"selector":{"name":"mediaSearchStatus"},"condition":"text","expected":"YOUR_EXPECTED_SEARCH_STATUS","timeoutMs":10000}},
        {"operation":"observe","params":{"selector":{"id":"OBSERVED_MEDIA_VIEW_ID"},"details":true},"expect":{"path":["matchCount"],"equals":1}},
        {"operation":"capture","params":{"target":{"class":"MainWindow"},"kind":"presented","title":"Search results"}}
      ],
      "next": null
    }
  ]
}
