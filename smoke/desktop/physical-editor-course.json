  "cases": [
    {
      "id": "P-TL-BIN-DROP",
      "sourceId": "TL-01",
      "area": "Timeline editing",
      "title": "Physical bin-to-timeline drop",
      "expected": "Dragging the observed media row onto V1 creates the correct source clip with its full duration; one Undo restores the empty timeline.",
      "evidence": [
        {
          "id": "operations",
          "kind": "json",
          "when": "during",
          "required": true,
          "caption": "Application readback and native input receipts."
        },
        {
          "id": "app-state",
          "kind": "image",
          "when": "after",
          "required": true,
          "caption": "The owned app or displayed preview at the observed result."
        }
      ],
      "steps": [
        {
          "id": "setup",
          "title": "Create and open a disposable timeline",
          "phase": "prepare"
        },
        {
          "id": "drop",
          "title": "Drag the observed media row onto V1",
          "phase": "execute"
        },
        {
          "id": "verify",
          "title": "Check the source, position and duration",
          "phase": "verify"
        },
        {
          "id": "restore",
          "title": "Capture the result and restore with Undo",
          "phase": "cleanup"
        }
      ],
      "proof": {
        "version": 1,
        "mode": "physical",
        "oracle": "editor-v1",
        "readOperation": "timeline.inspect",
        "actions": [
          {
            "id": "drop",
            "command": "drag",
            "stepId": "drop",
            "target": {
              "class": "QWidget"
            },
            "surface": "bin",
            "destination": "timeline",
            "checkpoint": "changed"
          },
          {
            "id": "keep",
            "command": "click",
            "stepId": "drop",
            "target": {
              "class": "QPushButton",
              "text": "Keep Timeline Settings"
            },
            "optional": true,
            "dialog": true,
            "checkpoint": "changed"
          },
          {
            "id": "undo",
            "command": "key",
            "stepId": "restore",
            "target": {
              "class": "TimelineWidget"
            },
            "key": "cmd+z",
            "surface": "view",
            "checkpoint": "restored"
          }
        ],
        "checkpoints": [
          {
            "id": "changed",
            "actions": [
              "drop"
            ],
            "verifier": "editor",
            "capture": "presented"
          },
          {
            "id": "restored",
            "actions": [
              "undo"
            ],
            "verifier": "editor",
            "capture": "presented"
          }
        ]
      }
    },
